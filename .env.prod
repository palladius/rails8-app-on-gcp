# .env.prod — Prod-specific config (committed to git, NO secrets!)
# Secrets stay in .env (not committed).
#
# Usage: bin/cloudbuild-submit prod

RAILS_ENV=production
ENVIRONMENT=prod
APP_NAME=palladius-genai-rails-app-prod
ENABLE_SIGNUP=false
ENABLE_GCP=true
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=yesplease
RUBY_YJIT_ENABLE=true
