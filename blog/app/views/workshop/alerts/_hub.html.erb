<%# 
  Workshop Alerts Hub (Issue #21 & #22).
  Centralized container for all educational workshop warnings.
  Allows zero-friction removal or disablement in true production environments
  via DISABLE_WORKSHOP_ALERTS=true or by deleting app/views/workshop/.
%>
<% unless ENV["DISABLE_WORKSHOP_ALERTS"] == "true" %>
  <div class="workshop-alerts-hub" data-turbo-permanent="true">
    <%= render "workshop/alerts/missing_admin" %>
    <%= render "workshop/alerts/stuck_jobs" %>
  </div>
<% end %>
