<div class="post-show">
  <h1 class="post-show__title">👤 My Profile</h1>

  <div class="post-show__body-glass">
    <div class="profile-avatar-glass">
      <%= image_tag @user.gravatar_url(size: 160), alt: "Avatar", class: "profile-avatar-img" %>
    </div>

    <div class="post-show__body-content">
      <table class="profile-table">
        <tr>
          <td class="profile-label">📧 Email</td>
          <td><%= @user.email_address %></td>
        </tr>
        <tr>
          <td class="profile-label">🧑‍💻 Username</td>
          <td style="text-transform: capitalize;"><%= @user.email_address.split('@').first %></td>
        </tr>
        <tr>
          <td class="profile-label">🏢 Domain</td>
          <td><%= @user.email_address.split('@').last %></td>
        </tr>
        <tr>
          <td class="profile-label">📅 Member since</td>
          <td><%= @user.created_at.strftime("%B %e, %Y") %></td>
        </tr>
        <tr>
          <td class="profile-label">🔄 Last updated</td>
          <td><%= time_tag @user.updated_at, "data-local": "time", "data-format": "%B %e, %Y %l:%M%P" %></td>
        </tr>
        <tr>
          <td class="profile-label">🔑 Sessions</td>
          <td><%= @user.sessions.count %> active</td>
        </tr>
        <% if @user.created_via.present? %>
          <tr>
            <td class="profile-label">🚀 Provisioned via</td>
            <td><code class="version-badge" style="background: #3b82f6;"><%= @user.created_via.upcase %></code></td>
          </tr>
        <% end %>
        <% if @user.description.present? %>
          <tr>
            <td class="profile-label">📝 Description</td>
            <td><%= @user.description %></td>
          </tr>
        <% end %>
      </table>

    </div>
  </div>

  <div class="post-show__actions">
    <%= link_to "⬅️ Back", posts_path, class: "post-action-btn post-action-btn--secondary" %>
  </div>
</div>
