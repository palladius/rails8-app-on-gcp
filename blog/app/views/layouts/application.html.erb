<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="app-header">
      <nav>
        <div class="app-brand">
          <%= link_to posts_path do %>
            <%= image_tag "rails8_on_gcp_logo_v3.jpg", alt: "Rails 8 on GCP", class: "header-logo" %>
          <% end %>
        </div>
        <div class="app-nav-links">
          <%= link_to "Posts", posts_path %>
          <% if authenticated? %>
            <%= link_to profile_path, class: "user-badge-link" do %><img src="<%= Current.user.gravatar_url(size: 28) %>" alt="" class="header-avatar"><span class="user-badge"><%= Current.user.email_address.split('@').first %></span><% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "sign-out-btn" %>
          <% end %>
        </div>
      </nav>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="app-footer">
      <div class="footer-top">
        <span>💎 <%= Rails.application.config.x.app.name %></span>
        <span class="version-badge">
          v<%= ENV.fetch("APP_VERSION") { File.read(Rails.root.join('..', 'VERSION')).strip rescue '?.?.?' } %>
        </span>
        <span><%= ENV.fetch("ENVIRONMENT", Rails.env) %></span>
        <% git_branch = `git -C #{Rails.root} rev-parse --abbrev-ref HEAD 2>/dev/null`.strip rescue nil %>
        <% if git_branch.present? && git_branch != 'main' %>
          <span class="version-badge" style="background: #8b5cf6;" title="Git branch">🌿 <%= git_branch %></span>
        <% end %>
        <% storage_service = Rails.configuration.active_storage.service.to_s %>
        <% is_gcs = storage_service.start_with?("google") %>
        <span class="version-badge" style="background: <%= is_gcs ? '#0d9488' : '#6b7280' %>;" title="ActiveStorage service: <%= storage_service %>">
          <%= is_gcs ? '☁️' : '💾' %> <%= is_gcs ? 'GCS' : 'Local' %>
        </span>
        <span>·</span>
        <a href="<%= Rails.application.config.x.app.github_url %>" target="_blank">📦 Code</a>
        <a href="<%= Rails.application.config.x.app.workshop_url %>" target="_blank">📖 Workshop</a>
      </div>
      <div class="footer-bottom">
        Made with
        <img src="https://upload.wikimedia.org/wikipedia/commons/7/73/Ruby_logo.svg" class="ruby-icon" alt="Ruby">
        love by
        <a href="https://github.com/emilianodellacasa" target="_blank">Emiliano</a> &amp;
        <a href="https://github.com/palladius" target="_blank">Riccardo</a>
      </div>
    </footer>
  </body>
</html>
