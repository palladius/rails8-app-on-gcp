<div id="<%= dom_id post %>">
  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= post.body %>
  </div>

  <% if post.cover_image.attached? %>
    <div class="post-card__hero" style="margin-top: 1em; max-width: 600px; position: relative; display: inline-block;">
      <%= image_tag post.cover_image, class: cover_image_classes, style: "max-width: 100%; height: auto; display: block; border-radius: 8px;", title: cover_image_title %>
      <%= cover_image_stamp_tag("post-card__stamp") %>
    </div>
  <% end %>

  <p>
    <strong>Updated at:</strong>
    <%= time_tag post.updated_at, "data-local": "time", "data-format": "%B %e, %Y %l:%M%P" %>
  </p>
  <div class="comments" style="margin-top: 1em; padding-top: 1em; border-top: 1px solid #eee;">
    <p>💬 <strong><%= pluralize(post.comments.count, "Comment") %></strong></p>
  </div>
</div>
