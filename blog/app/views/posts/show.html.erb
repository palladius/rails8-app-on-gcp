<%= turbo_stream_from @post %>

<div id="<%= dom_id @post %>" class="post-show">

  <div class="post-show__header">
    <div class="post-show__header-info">
      <h1 class="post-show__title"><%= @post.title %></h1>

      <%# === Meta line: right under title, before body === %>
      <p class="post-show__meta">
        <% if @post.user %>
          <%= image_tag @post.user.gravatar_url(size: 20), class: "post-show__author-avatar" %>
          <strong><%= @post.user.email_address.split('@').first %></strong>
          &nbsp;·&nbsp;
        <% end %>
        ✏️ Updated
        <%= time_tag @post.updated_at, "data-local": "time", "data-format": "%B %e, %Y %l:%M%P" %>
        &nbsp;·&nbsp;
        💬 <%= pluralize(@post.comments.count, "Comment") %>
        &nbsp;
        <% if @post.public? %>
          <span class="visibility-badge visibility-badge--public">🌍 Public</span>
        <% else %>
          <span class="visibility-badge visibility-badge--private">🔒 Private</span>
        <% end %>
      </p>
    </div>

    <% if @post.cover_image.attached? %>
      <div class="post-show__header-cover-wrapper">
        <div class="post-show__cover-actions">
          <%= button_to "🔄 Regenerate Cover", purge_cover_image_post_path(@post), method: :delete,
              class: "post-action-btn post-action-btn--secondary post-action-btn--compact",
              title: "Delete current cover image and generate a new one via Nano Banana AI",
              data: { turbo_confirm: "Delete current cover image and generate a new one?" } %>
        </div>

        <div id="post-show__hero-<%= @post.id %>" class="post-show__hero-glass">
          <%= image_tag @post.cover_image, class: cover_image_classes("post-show__hero-img"), title: cover_image_title %>
          <%= cover_image_stamp_tag("post-show__hero-stamp") %>
        </div>
      </div>
    <% end %>
  </div>

  <%# === Body content in its own glass card === %>
  <div class="post-show__body-glass">
    <div class="post-show__body-content">
      <%= @post.body %>
    </div>
  </div>
</div>

<div class="post-show__actions">
  <%= link_to "✏️ Edit", edit_post_path(@post), class: "post-action-btn" %>
  <%= link_to "⬅️ Back", posts_path, class: "post-action-btn post-action-btn--secondary" %>
  <%= button_to "🗑️ Destroy", @post, method: :delete, class: "post-action-btn post-action-btn--danger",
      data: { turbo_confirm: "Are you sure?" } %>
</div>

<%= render 'comments/comments', post: @post %>