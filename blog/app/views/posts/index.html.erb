<% content_for :title, "Posts" %>


<h1>Posts</h1>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Title</th>
      <th>🖼️ Images</th>
      <th>💬 Comments</th>
      <th>Updated at</th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each_with_index do |post, idx| %>
      <tr>
        <td style="text-align: center; white-space: nowrap;">
          <div><%= link_to idx + 1, post %></div>
          <div class="actions-row"><%= link_to "✏️", edit_post_path(post), title: "Edit" %><%= button_to "❌", post, method: :delete, form: { data: { turbo_confirm: "Delete '#{post.title}'?" } }, title: "Delete" %></div>
        </td>
        <td>
          <% if post.cover_image.attached? %>
            <%= image_tag post.cover_image, style: "height: 30px; width: auto; vertical-align: middle; margin-right: 8px;", title: "Cover Image" %>
          <% end %>
          <%= link_to post.title, post %>
        </td>
        <% image_count = (post.cover_image.attached? ? 1 : 0) + post.body.body&.attachments&.count.to_i %>
        <td style="text-align: center;"><%= image_count %></td>
        <td style="text-align: center;"><%= post.comments.size %></td>
        <% days_ago = (Date.today - post.updated_at.to_date).to_i %>
        <td><%= case days_ago when 0 then 'today' when 1 then 'yesterday' when 2..7 then "#{days_ago}d ago" else post.updated_at.year == Date.today.year ? post.updated_at.strftime('%-d %b') : post.updated_at.strftime('%-d %b %Y') end %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to "New post", new_post_path %>
