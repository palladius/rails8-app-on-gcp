<% if notice.present? %>
  <p class="flash-notice"><%= notice %></p>
<% end %>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Title</th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each_with_index do |post, idx| %>
      <tr>
        <td style="text-align: center; white-space: nowrap;">
          <div><%= link_to idx + 1, post %></div>
          <div class="actions-row"><%= link_to "✏️", edit_post_path(post), title: "Edit" %><%= button_to "❌", post, method: :delete, form: { data: { turbo_confirm: "Delete '#{post.title}'?" } }, title: "Delete" %></div>
        </td>
        <td><%= link_to post.title, post %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to "New post", new_post_path %>
