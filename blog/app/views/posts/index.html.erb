<% if notice.present? %>
  <p class="flash-notice"><%= notice %></p>
<% end %>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Title</th>
      <th>Body</th>
      <th>🖼️ Images</th>
      <th>💬 Comments</th>
      <th>Updated at</th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each_with_index do |post, idx| %>
      <tr>
        <td><%= link_to "👁️", post, title: "Show" %> <%= link_to "✏️", edit_post_path(post), title: "Edit" %> <%= button_to "❌", post, method: :delete, form: { data: { turbo_confirm: "Delete '#{post.title}'?" } }, style: "display:inline; background:none; border:none; cursor:pointer; padding:0; font-size:inherit;", title: "Delete" %> <%= idx + 1 %></td>
        <td><%= link_to post.title, post %></td>
        <td><%= truncate(post.body.to_plain_text, length: 80) %></td>
        <% image_count = (post.cover_image.attached? ? 1 : 0) + post.body.body&.attachments&.count.to_i %>
        <td style="text-align: center;"><%= image_count %></td>
        <td style="text-align: center;"><%= post.comments.size %></td>
        <td><%= post.updated_at.year == Date.today.year ? post.updated_at.strftime("%-d %b") : post.updated_at.strftime("%-d %b %Y") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to "New post", new_post_path %>
