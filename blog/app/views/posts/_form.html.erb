<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.rich_textarea :body %>
  </div>

  <div>
    <%= form.label :cover_image, "Cover Image (GCS)", style: "display: block" %>
    <% if post.persisted? && post.cover_image.attached? %>
      <div style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 1rem;">
        <%= image_tag post.cover_image, class: cover_image_classes, style: "height: 60px; width: auto; border-radius: 8px;", title: cover_image_title %>
        <%= button_to "🗑️ Delete & Regenerate Cover", purge_cover_image_post_path(post), method: :delete, class: "post-action-btn post-action-btn--secondary", style: "padding: 6px 14px; font-size: 0.85rem;",
            data: { turbo_confirm: "Delete current cover image and generate a new one?" } %>
      </div>
    <% end %>
    <%= form.file_field :cover_image %>
  </div>

  <div class="form-check">
    <%= form.check_box :public, class: "form-check__input" %>
    <%= form.label :public, "🌍 Make this post public", class: "form-check__label" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
