<% content_for :title, @query.present? ? "Search: #{@query}" : "Search" %>

<h1>🔎 Semantic Search</h1>
<p style="opacity: 0.8; margin-top: -0.5rem;">
  Finds posts by meaning, not just matching words: Gemini embeddings in Cloud SQL with pgvector,
  then Gemini answers from the closest posts (RAG).
</p>

<div style="display: flex; gap: 8px; margin: 16px 0;">
  <%= render "searches/form", query: @query %>
</div>

<% if @result %>
  <% if @result.notice %>
    <p class="flash-notice" id="search-mode-notice">ℹ️ <%= @result.notice %></p>
  <% end %>

  <% if @result.answer %>
    <section id="rag-answer" style="padding: 16px 20px; margin: 16px 0; border-radius: 10px; background: rgba(66,133,244,0.12); border-left: 4px solid #4285f4;">
      <h2 style="margin-top: 0; font-size: 1.1rem;">✨ Gemini answer</h2>
      <%= simple_format(@result.answer) %>
      <p style="font-size: 0.8rem; opacity: 0.7; margin-bottom: 0;">Generated by <%= SemanticSearch::CHAT_MODEL %> from the posts below. Numbers in [brackets] refer to them.</p>
    </section>
  <% end %>

  <% if @result.posts.any? %>
    <h2 style="font-size: 1.1rem;"><%= @result.mode == :semantic ? "Closest posts by meaning" : "Keyword matches" %></h2>
    <ol id="search-results">
      <% @result.posts.each do |post| %>
        <li style="margin-bottom: 12px;">
          <%= link_to post.title, post, style: "font-weight: 600;" %>
          <% if post.respond_to?(:neighbor_distance) && post.neighbor_distance %>
            <span style="font-size: 0.8rem; opacity: 0.7;">· <%= number_to_percentage((1 - post.neighbor_distance) * 100, precision: 0) %> similar</span>
          <% end %>
          <div style="font-size: 0.9rem; opacity: 0.8;"><%= truncate(post.body&.to_plain_text, length: 180) %></div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p id="search-results-empty">No posts found for “<%= @query %>”.</p>
  <% end %>
<% end %>

<p><%= link_to "← Back to posts", posts_path %></p>
