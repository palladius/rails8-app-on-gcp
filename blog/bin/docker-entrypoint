#!/bin/bash -e

# If running the rails server then create or migrate existing databases and seed initial admin user
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:prepare:queue || true
  ./bin/rails db:prepare:cache || true
  ./bin/rails db:prepare:cable || true
  if [ -n "$GOOGLE_CLOUD_ACCOUNT" ] || [ -n "$ADMIN_EMAIL" ]; then
    ./bin/rails db:seed || true
  fi
fi

exec "${@}"
