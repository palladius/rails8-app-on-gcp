# .env.dev — Dev-specific config (committed to git, NO secrets!)
# Secrets stay in .env (not committed).
#
# Usage: bin/cloudbuild-submit dev

RAILS_ENV=production
ENVIRONMENT=dev
APP_NAME=palladius-genai-rails-app-dev
GOOGLE_CLOUD_PROJECT=palladius-genai
ENABLE_SIGNUP=true
ENABLE_GCP=true
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=yesplease
RUBY_YJIT_ENABLE=true
