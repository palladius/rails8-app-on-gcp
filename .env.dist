# ==============================================================================
# Rails 8 on GCP - Environment Variables Configuration (.env.dist)
# Copy this file to .env and customize for your local or cloud environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# --- Admin Onboarding & Seeds (Step 1) ---
# Your Google / personal email to seed as the initial blog administrator.
ADMIN_EMAIL="riccardo@example.com"
# Initial seed password (optional, defaults to Ch4ng3m3!!1)
ADMIN_PASSWORD="Ch4ng3m3!!1"

# --- Google Cloud Platform (GCP) Configuration ---
GCP_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="your-gcp-project-id-rails-media"

# Note we'll change this over the course of the workshop
ACTIVE_STORAGE_SERVICE="local" # 'local' for dev, 'google' or 'google_dev' for GCS

# --- Database Configuration ---
# Local SQLite (default for bin/dev) or Local Docker Postgres:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/blog_development"

# --- Email Interception (Mailpit) ---
# In local Docker Compose, Mailpit catches all emails at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"

# --- Generative AI (Step 7: NanoBanana Auto-Cover Generator & Podcastifier) ---
# GEMINI_API_KEY="AIzaSy..."

# --- Zero-Trust IAP Local Testing (Quest 1) ---
# Simulate an incoming Google Cloud IAP authenticated email on localhost:
# IAP_MOCK_EMAIL="riccardo@google.com"
