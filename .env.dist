# .env.dist — Template for .env (secrets, NOT committed to git!)
# Copy to .env and fill in your values.
#
# Environment-specific config lives in .env.dev / .env.prod (committed).

# GCP Project Configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Identity Configuration
GCLOUD_USER="your-email@gmail.com"

# Rails Master Key (from blog/config/master.key)
RAILS_MASTER_KEY="your-master-key-hex-string"

# Database URL for Cloud SQL PostgreSQL
# Format: postgres://USER:PASS@localhost:5432/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgres://rails_user:PASSWORD@localhost:5432/rails_production?host=/cloudsql/PROJECT:REGION:INSTANCE"

# Cloud SQL connection name (PROJECT:REGION:INSTANCE)
CLOUD_SQL_CONNECTION="your-project:your-region:your-instance"
