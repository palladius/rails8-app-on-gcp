# ==============================================================================
# Rails 8 on GCP - Environment Variables Configuration (.env.dist)
# Copy this file to .env and customize for your local or cloud environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# --- Google Cloud Identity & Project ---
# Your primary Google account used for GCP Billing, Terraform, IAM, ADC, and IAP.
GOOGLE_CLOUD_ACCOUNT="your-personal-email@gmail.com"

# Blog administrator password for initial db:seed (optional, defaults to Ch4ng3m3!!1)
# NOTE: The administrator email defaults automatically to GOOGLE_CLOUD_ACCOUNT above!
APP_ADMIN_PASSWORD="Ch4ng3m3!!1"

GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Deployment region for Cloud Run, Cloud SQL and GCS. Keep it aligned with
# iac/variables.tf (default europe-west1): a Cloud Run service in a different
# region than its Cloud SQL instance cannot be reached by the connection name
# built as PROJECT:REGION:INSTANCE.
GOOGLE_CLOUD_REGION="europe-west1"

# --- Database Configuration ---

# Local SQLite (default for bin/dev) or Local Docker Postgres:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/blog_development"

# --- Generative AI (Step 7: NanoBanana Auto-Cover Generator & Podcastifier) ---
# GEMINI_API_KEY="AIzaSy..."
# Default audio languages for AI Podcastifier (comma-separated):
AUDIO_LANGUAGES="it,en"

# --- Zero-Trust Google Cloud IAP Configuration (Step 8) ---
# Comma-separated list of allowed Google identities for IAP auto-login (optional app-level filter):
IAP_ALLOWED_USERS="ricc@google.com,emiliano.dellacasa@gmail.com,palladiusbonton@gmail.com,riccardo.and.kate@gmail.com,riccardo.carlesso@gmail.com"

# --- Application Launch Mode / Telemetry (Anti-POLA) ---
# Override the displayed launch mode banner in UI footer (optional, auto-detected if omitted):
# RAILS8_ENV_LAUNCH_MODE="Hello! I am the native app launched with bin/dev on local SQLite."

APP_DESCRIPTION="Rails 8 on GCP (in .env.dist). The user didn't bother changing it!"
