# .env.dist — Template for .env (NOT committed to git!)
# Copy to .env and fill in your values.
#
# Usage:
#   bin/cloudbuild-submit dev   → deploys to palladius-genai-rails-app-dev
#   bin/cloudbuild-submit prod  → deploys to palladius-genai-rails-app-prod

# GCP Project Configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Identity Configuration
GCLOUD_USER="your-email@gmail.com"

# Rails Master Key (from blog/config/master.key)
RAILS_MASTER_KEY="your-master-key-hex-string"

# Database URL for Cloud SQL PostgreSQL
# Format: postgres://USER:PASS@localhost:5432/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgres://rails_user:PASSWORD@localhost:5432/rails_production?host=/cloudsql/PROJECT:REGION:INSTANCE"

# ActiveStorage service (default: "local" in dev, "google_prod" in prod)
# Set to "google_dev" to test GCS uploads locally.
# NOTE: GCS requires roles/iam.serviceAccountTokenCreator on the Cloud Run SA — see iac/cloudrun.tf.
# ACTIVE_STORAGE_SERVICE="local"

# Cloud SQL connection name (PROJECT:REGION:INSTANCE) — optional, defaults to auto-derived
# CLOUD_SQL_CONNECTION="your-project:your-region:your-instance"
